{
  "id": ".",
  "name": "The Machine",
  "short_name": "The Machine",
  "description": "Your personal assistant inbox",
  "start_url": ".",
  "scope": ".",
  "display": "fullscreen",
  "display_override": ["fullscreen", "standalone"],
  "handle_links": "preferred",
  "launch_handler": {"client_mode": ["focus-existing", "auto"]},
  "background_color": "#131518",
  "theme_color": "#131518",
  "related_applications": [{"platform": "webapp", "url": "manifest.webmanifest"}],
  "share_target": {
    "action": "share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [{"name": "files", "accept": ["application/pdf", ".pdf", "image/png", "image/jpeg", "image/gif", "image/webp", "text/plain", ".txt",
        "text/markdown", ".md", "text/csv", ".csv", ".tsv", "application/json", ".json", ".log", ".rtf", "message/rfc822", ".eml", "text/calendar", ".ics",
        ".docx", ".xlsx", ".pptx", ".odt", ".ods"]}]
    }
  },
  "icons": [
    {"src": "brand/app-icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any"},
    {"src": "brand/favicon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any"},
    {"src": "brand/app-icon-maskable-192.png", "sizes": "192x192", "type": "image/png", "purpose": "maskable"},
    {"src": "brand/app-icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable"}
  ]
}
